# App
APP_NAME=ai-chat-bot
DEBUG=false
ENV=production
TIMEZONE=Europe/Moscow
# Frontend URL for CORS (e.g., https://yourdomain.com). MUST be set in production.
FRONTEND_URL=

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_chat_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@postgres:5432/ai_chat_bot

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change_me_to_random_32_plus_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (Fernet key, generate via cryptography.fernet.Fernet.generate_key())
ENCRYPTION_KEY=generate_with_fernet=

# Yandex Cloud — GLOBAL FALLBACK (used when tenant has no own keys)
# Each tenant can override these in Dashboard → Settings → API Keys.
# Get API key and folder ID from https://yandex.cloud/ru/
YANDEX_SPEECHKIT_API_KEY=...
YANDEX_SPEECHKIT_FOLDER_ID=...
YANDEX_SPEECHKIT_BASE_URL=https://stt.api.cloud.yandex.net/speech/v1/stt:recognize

# Wazzup (WhatsApp, Telegram, Instagram via https://wazzup24.com)
# Each tenant sets their own API key in Dashboard → Settings → API Keys.
WAZZUP_BASE_URL=https://api.wazzup24.com/v3
# NOTE: Wazzup does NOT send HMAC signatures. It sends Authorization: Bearer <api_key>.
# The bot automatically verifies this header against the tenant's configured API key.

# CRM (optional — uncomment when connected)
# AMOCRM_BASE_URL=https://example.amocrm.ru
# AMOCRM_ACCESS_TOKEN=...
# BITRIX24_WEBHOOK_URL=https://example.bitrix24.ru/rest/1/...
# CRM webhook secret for verifying incoming status updates
CRM_WEBHOOK_SECRET=

# Rate Limits
RATE_LIMIT_IP_PER_MINUTE=100
RATE_LIMIT_TENANT_PER_MINUTE=1000

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Followup
FOLLOWUP_DEFAULT_RATE_LIMIT=1/4h

# Superadmin auto-seed (leave empty to skip)
# On first startup, creates superadmin with these credentials.
# IMPORTANT: Change the password immediately after first login.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
